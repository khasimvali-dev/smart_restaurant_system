# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database (MySQL, local only) ---
# Full production target: MySQL running on localhost.
DB_ENGINE=mysql+pymysql
DB_USER=root
DB_PASSWORD=khasim@1875
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_restaurant_db

# Set to "sqlite" to run the whole app with zero external services
# (creates instance/smart_restaurant.db). Useful for first run / demos.
USE_SQLITE_FALLBACK=true

# --- Business config ---
RESTAURANT_NAME=Smart Restaurant & Cafe
RESTAURANT_ADDRESS=123 MG Road, Bengaluru, KA
RESTAURANT_PHONE=+91-9876543210
RESTAURANT_GSTIN=29ABCDE1234F1Z5
DEFAULT_GST_PERCENT=5.0
CURRENCY_SYMBOL=Rs.

# --- Backup ---
BACKUP_DIR=backups
AUTO_BACKUP_ON_STARTUP=true
